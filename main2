        local mousePos = UserInputService:GetMouseLocation()
        RageBot.FOVCircle.Position = Vector2.new(mousePos.X, mousePos.Y)
        RageBot.FOVCircle.Radius = RageBot.FOV
        RageBot.FOVCircle.Visible = true
    elseif RageBot.FOVCircle then
        RageBot.FOVCircle.Visible = false
    end

    if FlickTrigger.FOVCircle and FlickTrigger.ShowFOVCircle and FlickTrigger.Enabled then
        local center = Camera.ViewportSize / 2
        FlickTrigger.FOVCircle.Position = center
        FlickTrigger.FOVCircle.Visible = true
    elseif FlickTrigger.FOVCircle then
        FlickTrigger.FOVCircle.Visible = false
    end

    if Backstab.FOVCircle and Backstab.ShowFOVCircle and Backstab.Enabled then
        local mousePos = UserInputService:GetMouseLocation()
        Backstab.FOVCircle.Position = Vector2.new(mousePos.X, mousePos.Y)
        Backstab.FOVCircle.Visible = true
    elseif Backstab.FOVCircle then
        Backstab.FOVCircle.Visible = false
    end

    if Backstab.Enabled and Backstab.Holding then
        local target = GetClosestPlayerForBackstab()
        if target then ExecuteBackstab(target) end
    end
    
    if MagnetAim.Circle and MagnetAim.CircleVisible and MagnetAim.Enabled then
        local mousePos = UserInputService:GetMouseLocation()
        MagnetAim.Circle.Position = Vector2.new(mousePos.X, mousePos.Y)
        MagnetAim.Circle.Visible = true
        MagnetAim.Circle.Radius = MagnetAim.Range
    elseif MagnetAim.Circle then
        MagnetAim.Circle.Visible = false
    end
    
    -- Rage Bot
    if RageBot.Enabled then
        local shouldRage = ShouldRage()
        
        if shouldRage then
            RageAimAtTarget()
        end
    end
    
    -- Magnet Aim
    if MagnetAim.Enabled and MagnetAim.Holding then
        local target = GetClosestPlayerToCursor()
        if target then
            MagnetPullPlayer(target)
        end
    end
    
    -- CFrame Speed
    if CFrameSpeed.Enabled and CFrameSpeed.Holding then
        StartCFrameSpeed()
    end
    
    -- BHop
    if BHop.Enabled then
        StartBHop()
    end
    
