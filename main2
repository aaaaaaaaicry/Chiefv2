task.spawn(function()
    while task.wait(0.03) do
        if TriggerBot.Enabled and TriggerBot.IsActive then
            local target = GetValidTargetAtMouse()
            if target then
                if TriggerBot.ShootMode == "click" then
                    local now = tick()
                    local clickInterval = math.max(TriggerBot.Delay / 1000, 0.01)
                    if now - TriggerBot.LastClickTime >= clickInterval then
                        ClickShoot()
                        TriggerBot.LastClickTime = now
                    end
                else
                    StartHold()
                end
            else
                if TriggerBot.ShootMode == "hold" then
                    StopHold()
                end
            end
        elseif TriggerBot.ShootMode == "hold" then
            StopHold()
        end
    end
end)

RunService.RenderStepped:Connect(function()
    -- FOV Circles
    if AimAssist.FOVCircle and AimAssist.ShowFOVCircle and AimAssist.Enabled then
